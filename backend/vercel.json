{
  "version": 2,
  "buildCommand": "pip install -r requirements.txt",
  "env": {
    "SECRET_KEY": "super-secret-key-for-wealth-management-demo",
    "ALGORITHM": "HS256",
    "DATABASE_URL": "sqlite:///./test.db",
    "ACCESS_TOKEN_EXPIRE_MINUTES": "30",
    "REFRESH_TOKEN_EXPIRE_MINUTES": "1440"
  },
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
